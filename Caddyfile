//         path /health
//     }
//     reverse_proxy @health localhost:8080

// }
weplan.io.kr {

    # API (REST + gRPC-Gateway)
    handle /api/v1/* {
        reverse_proxy http://127.0.0.1:8081
    }

    # WebSocket (반드시 별도 처리)
    handle /ws/* {
        reverse_proxy http://127.0.0.1:8081
    }

    # React SPA
    handle {
        root * /var/www/weplan
        file_server
        try_files {path} /index.html
    }
}

:80 {
    redir https://weplan.io.kr{uri}
}